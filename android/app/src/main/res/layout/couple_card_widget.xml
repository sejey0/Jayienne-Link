<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="2dp">

    <!-- Main Romantic Gradient Couple Hero Card (Tap anywhere to Hide / Unhide just like Main Screen) -->
    <LinearLayout
        android:id="@+id/widget_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_couple_card"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="18dp">

        <!-- 1. Top Header Row: Live Ticking Seconds Pill + Expand/Collapse Arrow on Right -->
        <LinearLayout
            android:id="@+id/widget_header_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_widget_timer"
                    android:contentDescription="@null" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3.5dp">

                    <ViewFlipper
                        android:id="@+id/seconds_flipper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:autoStart="true"
                        android:flipInterval="1000" />
                </FrameLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_chevron_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginLeft="4dp"
                android:src="@drawable/ic_widget_chevron_down"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- 2. Dual Avatars + Center Live Beating Heart Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|top"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Left Column: User Avatar + "You" Pill + Zodiac Pill -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_user_avatar"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <!-- "You" Status Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_widget_pill_bordered"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="8.5dp"
                    android:paddingRight="8.5dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:src="@drawable/dot_online"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4.5dp"
                        android:text="You"
                        android:textColor="#FFFFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- User Zodiac Pill -->
                <LinearLayout
                    android:id="@+id/widget_user_zodiac_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_widget_pill_bordered"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:id="@+id/widget_user_zodiac_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_user_zodiac_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4.5dp"
                        android:text="Aquarius"
                        android:textColor="#FFFFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Center Column: Live Beating Heart Animation (ViewFlipper pulse loop) -->
            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="84dp"
                android:gravity="center">

                <ViewFlipper
                    android:id="@+id/heart_flipper"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_gravity="center"
                    android:autoStart="true"
                    android:flipInterval="320">

                    <!-- Frame 1: Scale 1.0 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <FrameLayout
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_widget_heart_circle">
                            <ImageView
                                android:layout_width="29dp"
                                android:layout_height="29dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_widget_heart"
                                android:contentDescription="@null" />
                        </FrameLayout>
                    </FrameLayout>

                    <!-- Frame 2: Scale 1.10 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <FrameLayout
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_widget_heart_circle">
                            <ImageView
                                android:layout_width="33dp"
                                android:layout_height="33dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_widget_heart"
                                android:contentDescription="@null" />
                        </FrameLayout>
                    </FrameLayout>

                    <!-- Frame 3: Scale 1.20 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <FrameLayout
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_widget_heart_circle">
                            <ImageView
                                android:layout_width="37dp"
                                android:layout_height="37dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_widget_heart"
                                android:contentDescription="@null" />
                        </FrameLayout>
                    </FrameLayout>

                    <!-- Frame 4: Scale 1.10 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <FrameLayout
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_widget_heart_circle">
                            <ImageView
                                android:layout_width="33dp"
                                android:layout_height="33dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_widget_heart"
                                android:contentDescription="@null" />
                        </FrameLayout>
                    </FrameLayout>
                </ViewFlipper>
            </FrameLayout>

            <!-- Right Column: Partner Avatar + Status Pill + Zodiac Pill -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_partner_avatar"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <!-- Partner Active / Last Online Status Pill -->
                <LinearLayout
                    android:id="@+id/widget_partner_status_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_widget_pill_bordered"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="8.5dp"
                    android:paddingRight="8.5dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:id="@+id/widget_partner_status_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:src="@drawable/dot_offline"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_partner_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4.5dp"
                        android:text="Offline"
                        android:textColor="#FFFFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Partner Zodiac Pill -->
                <LinearLayout
                    android:id="@+id/widget_partner_zodiac_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_widget_pill_bordered"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:id="@+id/widget_partner_zodiac_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_partner_zodiac_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4.5dp"
                        android:text="Sagittarius"
                        android:textColor="#FFFFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Prominent Live Love Counter ("469 Days Together" + "1 Year • 3 Months • 12 Days") -->
        <LinearLayout
            android:id="@+id/widget_love_counter_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_days_together_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:shadowColor="#45000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="0 Days Together"
                android:textColor="#FFFFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_days_breakdown_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_widget_pill"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="0 Years • 0 Months • 0 Days"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 4. Expandable Detailed Section (Toggled via Hide / Unhide tap on card) -->
        <LinearLayout
            android:id="@+id/widget_expanded_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Divider -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3DFFFFFF" />

            <!-- Official Anniversary Date Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_widget_calendar"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_anniversary_date_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="Anniversary: --"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Live Ticking Precision Duration Box (y m d h m s) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_widget_pill"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ViewFlipper
                    android:id="@+id/duration_flipper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoStart="true"
                    android:flipInterval="1000" />
            </FrameLayout>

            <!-- Progress Toward Next Anniversary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_next_anniv_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 days until 1st Anniversary"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_next_anniv_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_anniv_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_widget_progress" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tap to collapse"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:textStyle="italic"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 5. Bottom Vitals Bar (My Battery • Distance • Partner Battery or Offline) -->
        <LinearLayout
            android:id="@+id/widget_vitals_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_widget_vitals_bar"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Left: My Battery -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_my_bat_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_widget_battery_full"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_my_bat_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="100%"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Vertical Divider 1 -->
            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="#3DFFFFFF" />

            <!-- Center: Distance -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13.5dp"
                    android:layout_height="13.5dp"
                    android:src="@drawable/ic_widget_location"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_distance_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4.5dp"
                    android:text="Location active"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Vertical Divider 2 -->
            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="#3DFFFFFF" />

            <!-- Right: Partner Battery or Offline -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_partner_vitals_icon"
                    android:layout_width="13.5dp"
                    android:layout_height="13.5dp"
                    android:src="@drawable/ic_widget_wifi_off"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_partner_vitals_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="Offline"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
